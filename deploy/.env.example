# Copy to .env (never commit .env) and replace every "change-me".
# Generate secrets with:  openssl rand -base64 48

# --- Public address the browser uses (scheme://host:port, no trailing slash) ---
PUBLIC_URL=http://localhost:8088
HTTP_PORT=8088
# true only when users open the site over HTTPS (TLS in front of nginx).
AUTH_COOKIE_SECURE=false

# --- Where the frontend repo is, relative to this deploy/ folder ---
FRONTEND_DIR=../../generic-front/app

TZ=Asia/Shanghai
# Language when the browser sends none: zh-CN or en-US.
ERP_DEFAULT_LOCALE=zh-CN

# --- MySQL ---
MYSQL_DATABASE=generic_erp
MYSQL_USER=erp
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_HOST_PORT=3307

# --- Redis ---
REDIS_PASSWORD=change-me

# --- JWT signing keys (two different long random values) ---
AUTHENTICATION_SECRET_KEY_ACCESS=change-me
AUTHENTICATION_SECRET_KEY_REFRESH=change-me
ACCESS_TIMEOUT=900000
REFRESH_TIMEOUT=604800000

# --- Purchasing exception alerts (department_tb ids, comma separated) ---
ERP_EXCEPTION_NOTIFY_DEPT_IDS=
ERP_EXCEPTION_APPROVER_DEPT_NAMES=PMC

# --- Old ERP (高格 VEPRO, SQL Server) read-only sync. Not a container. ---
# Use a SELECT-only login. SQL Server on the Docker host: use host.docker.internal.
LEGACY_ERP_ENABLED=false
LEGACY_ERP_DB_URL=jdbc:sqlserver://sqlserver-host:1433;databaseName=VEPRO;encrypt=true;trustServerCertificate=true
LEGACY_ERP_DB_USERNAME=
LEGACY_ERP_DB_PASSWORD=

JAVA_OPTS=-XX:MaxRAMPercentage=75
